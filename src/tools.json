      "type": "object",
      "properties": {
        "group_by": {
          "type": "string",
          "enum": [
            "none",
            "provider",
            "directory"
          ]
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "group_by",
        "offset",
        "limit"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "search_events",
